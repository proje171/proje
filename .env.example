NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Optional SMTP settings. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional PostgreSQL connection for Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ibaysoft