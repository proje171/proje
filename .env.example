NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Optional SMTP settings. Never commit real credentials.
# SMTP_HOST: Your email provider's SMTP server. Gmail example: smtp.gmail.com
SMTP_HOST=
# Use 587 with SMTP_SECURE=false, or 465 with SMTP_SECURE=true.
SMTP_PORT=587
SMTP_SECURE=false
# Full mailbox/login name, usually your full email address.
SMTP_USER=
# SMTP password. For Gmail, create a Google App Password; do not use your normal password.
SMTP_PASS=
# Verified sender email address, usually the same mailbox as SMTP_USER.
SMTP_FROM=

# Optional PostgreSQL connection for Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ibaysoft